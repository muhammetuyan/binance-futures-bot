# Yalnızca Binance Futures Testnet anahtarlarını buraya girin.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# İsteğe bağlı ayarlar
ATLAS_MODE=paper
ATLAS_PAPER_BALANCE=100
ATLAS_TESTNET=true
# Boş bırakılırsa likit USDT perpetual pariteleri dinamik taranır.
ATLAS_SYMBOLS=
ATLAS_INTERVAL=15m
ATLAS_CONFIRMATION_INTERVAL=1h
ATLAS_SCAN_INTERVAL_MINUTES=15
ATLAS_LEVERAGE=10
ATLAS_RISK_PER_TRADE=0.02
ATLAS_DAILY_LOSS_LIMIT=0.10
ATLAS_MIN_MARGIN_USDT=5
ATLAS_MAX_MARGIN_USDT=40
ATLAS_MAX_MARGIN_FRACTION=0.40
ATLAS_MIN_SIGNAL_SCORE=85
ATLAS_BREAKOUT_LOOKBACK=12
ATLAS_ATR_STOP_MULTIPLE=2.2
ATLAS_MIN_ADX=20
ATLAS_MIN_VOLUME_RATIO=0.8
ATLAS_MIN_STOP_PERCENT=0.8

# Canlı hesap kilidi. Testnet aşaması bitmeden KULLANMAYIN.
# ATLAS_ALLOW_LIVE=I_UNDERSTAND_THE_RISK
